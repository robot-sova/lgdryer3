---
// One county × one appliance: /washer-repair/<county>/ and /dryer-repair/<county>/.
// Data and the rules for it live in src/data/counties.ts — read them before adding text here.
// What makes two county pages different is the data (cities, local paragraph, county notes, real
// calls); the shared blocks below are the same service, described once.
import Layout from '../layouts/Layout.astro';
import { existsSync } from 'node:fs';
import Breadcrumbs from './Breadcrumbs.astro';
import { COUNTIES, type County } from '../data/counties';
import { recentCallsInCounty, VISIT_TEXT } from '../data/recentCalls';
import { BRANDS, problemsFor, pricesFor, serviceFaqs } from '../data/service';
import { cityPagesInCounty } from '../data/cities';
import CallbackForm from './CallbackForm.astro';
import { brandHref } from '../data/brands';

interface Props { county: County; appliance: 'washer' | 'dryer' }
const { county, appliance } = Astro.props;
const isWasher = appliance === 'washer';
const App = isWasher ? 'Washer' : 'Dryer';
const app = isWasher ? 'washer' : 'dryer';
const other = isWasher ? 'dryer' : 'washer';
const SITE = 'https://washeranddryer.repair';
const url = `${SITE}/${app}-repair/${county.slug}/`;

const problems = problemsFor(appliance);
const prices = pricesFor(appliance);

const calls = recentCallsInCounty(county.slug);
const others = COUNTIES.filter((c) => c.slug !== county.slug);
// Owner 2026-10-10: same-day in all seven counties, no trip fee anywhere, every brand, 90-day warranty.
const when = county.sameDay
  ? 'Same-day service, no trip fee, 90-day warranty on parts and labor.'
  : 'We confirm the day and the arrival window when you book. No trip fee, 90-day warranty on parts and labor.';

const faqs = serviceFaqs(appliance, county.name);
const cityPages = cityPagesInCounty(county.slug, appliance);

// Searchers type both "washer repair" and "washing machine repair" (Ahrefs: "washing machine repair
// los angeles" 150/mo, "… san diego" 150/mo), and "dryer repair" with "gas dryer" — so both forms are
// in the title and the H1.
const title = isWasher
  ? `Washer Repair ${county.name}, CA — Washing Machine Service`
  : `Dryer Repair ${county.name}, CA — Gas & Electric Dryers`;
const h1 = isWasher ? `Washer & Washing Machine Repair in ${county.name}` : `Gas & Electric Dryer Repair in ${county.name}`;
const description = `${App} repair in ${county.name}: ${county.cities.slice(0, 3).map((c) => c.label).join(', ')} and more. All brands, prices from $150, $69 diagnostic waived. (323) 990-7550.`;
const genericHero = isWasher
  ? { img: '/images/hubs/washer-index-hero-neutral.webp', alt: `Front-load washing machine in a laundry room — washer repair in ${county.name}` }
  : { img: '/images/hubs/repairs-index-hero-neutral.webp', alt: `Technician repairing a dryer — dryer repair in ${county.name}` };
// Own local photo when there is one (public/images/places/<appliance>-<county>[-<city>].webp,
// scripts/gen-brand-photos.mjs --prompts scripts/place-photo-prompts.json).
const placeImg = `/images/places/${`${app}-${county.slug}`}.webp`;
const hero = existsSync(`public${placeImg}`)
  ? { img: placeImg, alt: `Technician repairing a ${isWasher ? 'washing machine' : 'dryer'} in a home in ${county.name}` }
  : genericHero;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      serviceType: `${App} repair`,
      name: `${App} repair in ${county.name}`,
      provider: { '@id': `${SITE}/#business` },
      areaServed: { '@type': 'AdministrativeArea', name: `${county.name}, CA` },
      url,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Layout title={title} description={description} hubHeroImg={hero.img} ogImage={hero.img} hubHeroAlt={hero.alt}>
  <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Service Areas', href: '/service-area/' }, { label: `${App} repair — ${county.name}` }]} />
  <div class="maintext county-page">
    <h1>{h1}</h1>
    <p class="county-lead">
      We repair {app}s in homes across {county.name} — {county.cities.slice(0, 5).map((c) => c.label).join(', ')} and the surrounding cities.
      A licensed technician (BHGS #49573) diagnoses the machine at your home and gives you the exact price before any work;
      the $69 diagnostic is waived when you approve the repair. {when}
    </p>
    <div class="cta-buttons">
      <a href="tel:3239907550" class="button-85">📞 Call (323) 990-7550</a>
      <a href="/book/" class="button-85">📅 Book online</a>
    </div>

    <CallbackForm place={county.name} appliance={appliance} />

    <h2>{App} repair in {county.short}: what we see here</h2>
    <p>{county.local}</p>
    <p>{isWasher ? county.washerNote : county.dryerNote}</p>

    <h2>Cities we serve in {county.name}</h2>
    <div class="index-grid">
      {county.cities.map((c) => {
        // A city page for this appliance wins over the older LG dryer city page.
        const cp = cityPages.find((x) => x.city === c.label);
        if (cp) return <a href={`/${app}-repair/${county.slug}/${cp.slug}/`} class="index-card"><div class="ic-name">{App} repair in {c.label}</div></a>;
        return c.page
          ? <a href={`/areas/${c.page}/`} class="index-card"><div class="ic-name">{c.label}</div></a>
          : <div class="index-card index-card-static"><div class="ic-name">{c.label}</div></div>;
      })}
    </div>
    <p class="county-small">Not on the list? If you are in {county.name}, call — we most likely cover you.</p>

    {calls.length > 0 && (
      <section class="recent-calls" aria-labelledby="county-calls-title">
        <h2 id="county-calls-title">Recent calls in {county.name}</h2>
        <p class="recent-calls-note">Real requests we received, with the problem as the customer described it. No names or addresses.</p>
        <ul class="recent-calls-list">
          {calls.map((c) => (
            <li class="recent-call">
              <div class="rc-head"><span class="rc-month">{c.month}</span><span class="rc-place">{c.place}</span></div>
              <div class="rc-body"><strong>{c.appliance}</strong> — {c.reported}.</div>
              <div class="rc-visit">{VISIT_TEXT[c.visit]}</div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2>Common {app} problems we fix</h2>
    <div class="index-grid">
      {problems.map((p) => <a href={p.href} class="index-card"><div class="ic-name">{p.label}</div></a>)}
    </div>

    <h2>{App} repair prices</h2>
    <p>Typical ranges including parts and labor. The technician confirms the exact price after the diagnostic, before any work.</p>
    <table class="county-prices">
      <tbody>
        <tr><td>Diagnostic visit</td><td>$69, waived with repair</td></tr>
        {prices.map((p) => <tr><td><a href={p.href}>{p.label}</a></td><td>{p.range}</td></tr>)}
      </tbody>
    </table>

    <h2>Brands we repair</h2>
    <p>{BRANDS.map((b, i) => { const h = brandHref(b, appliance); return <>{i > 0 && ' · '}{h ? <a href={h}>{b}</a> : b}</>; })} — every brand of residential {app}, front-load, top-load and stacked. <a href="/brands/">All brands →</a></p>

    <h2>How a visit works</h2>
    <ol>
      <li>Call (323) 990-7550 or <a href="/book/">book online</a> — tell us the brand, the model if you have it, and what the {app} does.</li>
      <li>We confirm the day and the arrival window. Hours: Monday–Saturday, 8am–8pm; online booking is open any time.</li>
      <li>The technician diagnoses the {app}, gives you the price, and repairs it with your approval — usually in the same visit.</li>
    </ol>

    <h2>Questions from {county.name} customers</h2>
    {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}

    <h2>Also in {county.name}</h2>
    <p><a href={`/${other}-repair/${county.slug}/`}>{other === 'washer' ? 'Washer' : 'Dryer'} repair in {county.name} →</a></p>

    <h2>Other counties we serve</h2>
    <div class="index-grid">
      {others.map((c) => <a href={`/${app}-repair/${c.slug}/`} class="index-card"><div class="ic-name">{c.name}</div></a>)}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Layout>
