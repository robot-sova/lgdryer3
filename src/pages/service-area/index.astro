---
// Hub for the seven counties (src/data/counties.ts): each county links its washer and dryer page.
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { COUNTIES } from '../../data/counties';
---
<Layout hubHeroImg="/images/hubs/areas-index-hero.webp" hubHeroAlt="Laundry Medic technician with service van — washer and dryer repair across seven Southern California counties" title="Washer & Dryer Repair Service Area | 7 SoCal Counties" description="Washer and dryer repair in Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties. $69 diagnostic. (323) 990-7550.">
  <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Service Areas' }]} />
  <div class="maintext county-page">
    <h1>Washer &amp; Dryer Repair Service Area</h1>
    <p>We repair washers and dryers in seven Southern California counties. Pick your county for the cities we cover, typical prices and how scheduling works there. Same-day service in all seven counties, no trip fee, every brand, 90-day warranty on parts and labor.</p>
    {COUNTIES.map((c) => (
      <section class="county-hub-row">
        <h2>{c.name}</h2>
        <p class="county-small">{c.cities.slice(0, 6).map((x) => x.label).join(' · ')}{c.cities.length > 6 ? ' · …' : ''}</p>
        <div class="index-grid">
          <a href={`/washer-repair/${c.slug}/`} class="index-card"><div class="ic-name">Washer repair in {c.short}</div></a>
          <a href={`/dryer-repair/${c.slug}/`} class="index-card"><div class="ic-name">Dryer repair in {c.short}</div></a>
        </div>
      </section>
    ))}
    <h2>Book a visit</h2>
    <p>Call (323) 990-7550, Monday–Saturday 8am–8pm, or book online any time.</p>
    <div class="cta-buttons">
      <a href="tel:3239907550" class="button-85">📞 CALL US</a>
      <a href="/book/" class="button-85">📅 BOOK ONLINE</a>
    </div>
  </div>
</Layout>
